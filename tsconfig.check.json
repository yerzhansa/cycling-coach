{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "tools/**/*.ts",
    "packages/*/tests/**/*.ts",
    "apps/*/tests/**/*.ts",
    "apps/desktop-renderer/src/global.d.ts",
    "packages/sport-cycling/src/markdown.d.ts",
    "packages/kernel/src/store/migrations/sql-assets.d.ts",
    "packages/coach/src/daemon/ws-server-options.d.ts",
    "vitest.config.ts"
  ]
}
